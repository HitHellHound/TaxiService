<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="initial-schema" author="cie">
        <createTable tableName="passenger">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_passenger"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints
                        nullable="false"
                        unique="true" uniqueConstraintName="unq_passenger_email"/>
            </column>
            <column name="phone" type="VARCHAR(20)">
                <constraints
                        nullable="false"
                        unique="true" uniqueConstraintName="unq_passenger_phone"/>
            </column>
            <column name="deleted_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="add-passenger-email-index" author="cie">
        <createIndex indexName="idx_passenger_email"
                     tableName="passenger"
                     unique="true">
            <column name="email"/>
        </createIndex>
    </changeSet>
    <changeSet id="add-passenger-phone-index" author="cie">
        <createIndex indexName="idx_passenger_phone"
                     tableName="passenger"
                     unique="true">
            <column name="phone"/>
        </createIndex>
    </changeSet>
    <changeSet id="add-passenger-email-format-check" author="cie">
        <sql>
            ALTER TABLE passenger
            ADD CONSTRAINT chk_passenger_email_format
            CHECK (email ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$');
        </sql>
        <rollback>
            ALTER TABLE passenger
            DROP CONSTRAINT chk_passenger_email_format;
        </rollback>
    </changeSet>
    <changeSet id="add-passenger-phone-format-check" author="cie">
        <sql>
            ALTER TABLE passenger
            ADD CONSTRAINT chk_passenger_phone_format
            CHECK (phone ~ '^\+375(25|29|33|44)\d{7}$');
        </sql>
        <rollback>
            ALTER TABLE passenger
            DROP CONSTRAINT chk_passenger_phone_format;
        </rollback>
    </changeSet>
    <changeSet id="init_schema_created_tag" author="cie">
        <tagDatabase tag="init_schema_created"/>
    </changeSet>
</databaseChangeLog>