<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="create-driver-status-enum" author="cie">
        <sql>
            CREATE TYPE driver_status AS ENUM ('FREE', 'ON_TRIP');
        </sql>

        <rollback>
            DROP TYPE driver_status;
        </rollback>
    </changeSet>
    <changeSet id="create-driver-info-table" author="cie">
        <createTable tableName="driver_info">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_driver_status"/>
            </column>

            <column name="car_id" type="BIGINT"/>

            <column name="status" type="driver_status">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>
    <changeSet id="add-free-driver-on-car-info-index" author="cie">
        <sql>
            CREATE INDEX idx_free_driver_on_car_info
            ON driver_info(id)
            WHERE car_id IS NOT NULL
            AND status = 'FREE'
            AND deleted_at IS NULL
        </sql>

        <rollback>
            DROP INDEX idx_free_driver_on_car_info;
        </rollback>
    </changeSet>
    <changeSet id="driver-info-schema-created-tag" author="cie">
        <tagDatabase tag="driver_info_schema_created"/>
    </changeSet>
</databaseChangeLog>