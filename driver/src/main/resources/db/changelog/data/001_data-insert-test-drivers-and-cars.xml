    <changeSet id="001_data-link-drivers-and-cars" author="cie">
        <update tableName="driver">
            <column name="car_id" valueComputed="(SELECT id FROM car WHERE number = '1234AB-1')"/>
            <where>email = 'alex.johnson@example.com'</where>
        </update>
        <update tableName="driver">
            <column name="car_id" valueComputed="(SELECT id FROM car WHERE number = '2345BC-2')"/>
            <where>email = 'maria.smith@example.com'</where>
        </update>
        <update tableName="driver">
            <column name="car_id" valueComputed="(SELECT id FROM car WHERE number = '3456CD-3')"/>
            <where>email = 'john.doe@example.com'</where>
        </update>
        <update tableName="driver">
            <column name="car_id" valueComputed="(SELECT id FROM car WHERE number = '6789FG-6')"/>
            <where>email = 'olga.petrova@example.com'</where>
