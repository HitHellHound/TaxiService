<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="001_data-insert-test-cars" author="cie">
        <insert tableName="car">
            <column name="color" value="Red"/>
            <column name="brand" value="Toyota"/>
            <column name="number" value="1234AB-1"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="Blue"/>
            <column name="brand" value="BMW"/>
            <column name="number" value="2345BC-2"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="Black"/>
            <column name="brand" value="Mercedes"/>
            <column name="number" value="3456CD-3"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="White"/>
            <column name="brand" value="Audi"/>
            <column name="number" value="4567DE-4"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="Green"/>
            <column name="brand" value="Volkswagen"/>
            <column name="number" value="5678EF-5"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="Yellow"/>
            <column name="brand" value="Hyundai"/>
            <column name="number" value="6789FG-6"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="Gray"/>
            <column name="brand" value="Kia"/>
            <column name="number" value="7890GH-7"/>
        </insert>
        <insert tableName="car">
            <column name="color" value="Orange"/>
            <column name="brand" value="Nissan"/>
            <column name="number" value="8901HI-8"/>
        </insert>

        <rollback>
            <delete tableName="car">
                <where>number IN ('1234AB-1','2345BC-2',
                    '3456CD-3','4567DE-4',
                    '5678EF-5','6789FG-6',
                    '7890GH-7','8901HI-8')
                </where>
            </delete>
        </rollback>
    </changeSet>

