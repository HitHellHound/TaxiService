            <where>email = 'ivan.ivanov@example.com'</where>
        </update>

        <rollback>
            <update tableName="driver">
                <column name="car_id" value="NULL"/>
                <where>email IN ('alex.johnson@example.com',
                    'maria.smith@example.com',
                    'john.doe@example.com',
                    'michael.brown@example.com',
                    'olga.petrova@example.com',
                    'ivan.ivanov@example.com')
